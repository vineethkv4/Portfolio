# Server-only vault gate secrets — never expose to the client
VAULT_PASSCODE=replace-with-shared-passcode
VAULT_JWT_SECRET=replace-with-long-random-string

# Signal passcodes. Set these in Vercel env as well. Do not commit real values.
# SIGNAL_JWT_SECRET falls back to VAULT_JWT_SECRET when unset.
SIGNAL_CODE_DESIGN=
SIGNAL_CODE_TECH=
SIGNAL_CODE_BOTH=
SIGNAL_JWT_SECRET=
# Unlock cookie + JWT last 30 minutes; idle lock at 20 minutes.

# Optional: used for absolute URLs in sitemap
NEXT_PUBLIC_SITE_URL=https://example.com

# Connect form — Web3Forms public access key (safe to expose; it is the form id)
NEXT_PUBLIC_WEB3FORMS_KEY=
