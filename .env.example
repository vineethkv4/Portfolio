# Server-only vault gate secrets — never expose to the client
VAULT_PASSCODE=replace-with-shared-passcode
VAULT_JWT_SECRET=replace-with-long-random-string
# Signal passcodes live in lib/signal/passcodes.ts (server-only). Rotate there.
# Unlock cookie + JWT last 30 minutes; idle lock at 20 minutes. Then the passcode gate shows again.
# TODO: move Signal passcodes to env + hash before production

# Optional: used for absolute URLs in sitemap
NEXT_PUBLIC_SITE_URL=https://example.com

# Connect form — Web3Forms public access key (safe to expose; it is the form id)
NEXT_PUBLIC_WEB3FORMS_KEY=
